<% layout("/layouts/boilerplate") %>
<div class="row mt-3">
    <div class="col-8 offset-2">
    <h3> Listing Details :</h3>
    </div>
    <div class="card col-6 offset-2 show-card">
        <img src="<%= listing.image.url %>" alt="listing_image" class="card-img-top show-img">
        <div class="card-body">
            <p class="card-text">
                 <b> <%= listing.title %></b> <br>
                 <%= listing.description %> <br>
                 &#x20b9; <%= listing.price.toLocaleString("en-IN") %> <br>
                 <%= listing.location %> <br>
                 <li><%= listing.country %></li>
                </p>
        </div>
    </div>
   
    <br>
   
</div>
<div class="btns ">
    <a href="/listings/<%= listing._id %>/edit" class="btn btn-dark offset-2 edit-btn">Edit </a>
<form method="POST" action="/listings/<%=listing._id %>?_method=DELETE">
    <button class="btn btn-dark offset-2">Delete </button>
</form>
</div>
